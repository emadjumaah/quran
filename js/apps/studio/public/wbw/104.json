{"1":[["waylun","Woe"],["likulli","to every"],["humazatin","slanderer"],["lumazatin","backbiter"]],"2":[["alladhī","The one who"],["jamaʿa","collects"],["mālan","wealth"],["waʿaddadahu","and counts it"]],"3":[["yaḥsabu","Thinking"],["anna","that"],["mālahu","his wealth"],["akhladahu","will make him immortal"]],"4":[["kallā","Nay"],["layunbadhanna","Surely he will be thrown"],["fī","in"],["l-ḥuṭamati","the Crusher"]],"5":[["wamā","And what"],["adrāka","will make you know"],["mā","what"],["l-ḥuṭamatu","the Crusher (is)"]],"6":[["nāru","A Fire"],["l-lahi","Allah"],["l-mūqadatu","kindled"]],"7":[["allatī","Which"],["taṭṭaliʿu","mounts up"],["ʿalā","to"],["l-afidati","the hearts"]],"8":[["innahā","Indeed, it"],["ʿalayhim","(will be) upon them"],["mu'ṣadatun","closed over"]],"9":[["fī","In"],["ʿamadin","columns"],["mumaddadatin","extended"]]}