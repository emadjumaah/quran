{"1":[["wal-ḍuḥā","By the morning brightness"]],"2":[["wa-al-layli","And the night"],["idhā","when"],["sajā","it covers with darkness"]],"3":[["mā","Not"],["waddaʿaka","has forsaken you"],["rabbuka","your Lord"],["wamā","and not"],["qalā","He is displeased"]],"4":[["walalākhiratu","And surely the Hereafter"],["khayrun","(is) better"],["laka","for you"],["mina","than"],["l-ūlā","the first"]],"5":[["walasawfa","And soon"],["yuʿ'ṭīka","will give you"],["rabbuka","your Lord"],["fatarḍā","then you will be satisfied"]],"6":[["alam","Did not"],["yajid'ka","He find you"],["yatīman","an orphan"],["faāwā","and give shelter"]],"7":[["wawajadaka","And He found you"],["ḍāllan","lost"],["fahadā","so He guided"]],"8":[["wawajadaka","And He found you"],["ʿāilan","in need"],["fa-aghnā","so He made self-sufficient"]],"9":[["fa-ammā","So as for"],["l-yatīma","the orphan"],["falā","then (do) not"],["taqhar","oppress"]],"10":[["wa-ammā","And as for"],["l-sāila","one who asks"],["falā","then (do) not"],["tanhar","repel"]],"11":[["wa-ammā","But as for"],["biniʿ'mati","(the) Favor"],["rabbika","(of) your Lord"],["faḥaddith","narrate"]]}