{"1":[["wal-shamsi","By the sun"],["waḍuḥāhā","and its brightness"]],"2":[["wal-qamari","And the moon"],["idhā","when"],["talāhā","it follows it"]],"3":[["wal-nahāri","And the day"],["idhā","when"],["jallāhā","it displays it"]],"4":[["wa-al-layli","And the night"],["idhā","when"],["yaghshāhā","it covers it"]],"5":[["wal-samāi","And the heaven"],["wamā","and (He) Who"],["banāhā","constructed it"]],"6":[["wal-arḍi","And the earth"],["wamā","and by (He) Who"],["ṭaḥāhā","spread it"]],"7":[["wanafsin","And (the) soul"],["wamā","and (He) Who"],["sawwāhā","proportioned it"]],"8":[["fa-alhamahā","And He inspired it"],["fujūrahā","(to distinguish) its wickedness"],["wataqwāhā","and its righteousness"]],"9":[["qad","Indeed"],["aflaḥa","he succeeds"],["man","who"],["zakkāhā","purifies it"]],"10":[["waqad","And indeed"],["khāba","he fails"],["man","who"],["dassāhā","buries it"]],"11":[["kadhabat","Denied"],["thamūdu","Thamud"],["biṭaghwāhā","by their transgression"]],"12":[["idhi","When"],["inbaʿatha","(was) sent forth"],["ashqāhā","(the) most wicked of them"]],"13":[["faqāla","But said"],["lahum","to them"],["rasūlu","(the) Messenger"],["l-lahi","(of) Allah"],["nāqata","(It is the) she-camel"],["l-lahi","(of) Allah"],["wasuq'yāhā","and her drink"]],"14":[["fakadhabūhu","But they denied him"],["faʿaqarūhā","and they hamstrung her"],["fadamdama","So destroyed"],["ʿalayhim","them"],["rabbuhum","their Lord"],["bidhanbihim","for their sin"],["fasawwāhā","and leveled them"]],"15":[["walā","And not"],["yakhāfu","He fears"],["ʿuq'bāhā","its consequences"]]}