{"1":[["bis'mi","In (the) name"],["l-lahi","(of) Allah"],["l-raḥmāni","the Most Gracious"],["l-raḥīmi","the Most Merciful"]],"2":[["al-ḥamdu","All praises and thanks"],["lillahi","(be) to Allah"],["rabbi","the Lord"],["l-ʿālamīna","of the universe"]],"3":[["al-raḥmāni","The Most Gracious"],["l-raḥīmi","the Most Merciful"]],"4":[["māliki","(The) Master"],["yawmi","(of the) Day"],["l-dīni","(of the) Judgment"]],"5":[["iyyāka","You Alone"],["naʿbudu","we worship"],["wa-iyyāka","and You Alone"],["nastaʿīnu","we ask for help"]],"6":[["ih'dinā","Guide us"],["l-ṣirāṭa","(to) the path"],["l-mus'taqīma","the straight"]],"7":[["ṣirāṭa","(The) path"],["alladhīna","(of) those"],["anʿamta","You have bestowed (Your) Favors"],["ʿalayhim","on them"],["ghayri","not (of)"],["l-maghḍūbi","those who earned (Your) wrath"],["ʿalayhim","on themselves"],["walā","and not"],["l-ḍālīna","(of) those who go astray"]]}