{"1":[["idhā","When"],["zul'zilati","is shaken"],["l-arḍu","the earth"],["zil'zālahā","(with) its earthquake"]],"2":[["wa-akhrajati","And brings forth"],["l-arḍu","the earth"],["athqālahā","its burdens"]],"3":[["waqāla","And says"],["l-insānu","man"],["mā","What"],["lahā","(is) with it"]],"4":[["yawma-idhin","That Day"],["tuḥaddithu","it will report"],["akhbārahā","its news"]],"5":[["bi-anna","Because"],["rabbaka","your Lord"],["awḥā","inspired"],["lahā","[to] it"]],"6":[["yawma-idhin","That Day"],["yaṣduru","will proceed"],["l-nāsu","the mankind"],["ashtātan","(in) scattered groups"],["liyuraw","to be shown"],["aʿmālahum","their deeds"]],"7":[["faman","So whoever"],["yaʿmal","does"],["mith'qāla","(equal to the) weight"],["dharratin","(of) an atom"],["khayran","good"],["yarahu","will see it"]],"8":[["waman","And whoever"],["yaʿmal","does"],["mith'qāla","(equal to the) weight"],["dharratin","(of) an atom"],["sharran","evil"],["yarahu","will see it"]]}